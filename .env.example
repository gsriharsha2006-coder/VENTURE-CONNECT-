# Supabase foundation. Leave blank to run the mock/demo MVP.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred public browser key from Supabase project settings.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Temporary backward-compatible fallback. Leave blank when using the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/admin-only Supabase key. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay is a future integration. Do not use these in Phase 2.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI providers are future integrations. VC Readiness Report remains mock-first in Phase 2.
AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
SARVAM_API_KEY=

# Local app URL used for auth redirects when Supabase is configured.
NEXT_PUBLIC_APP_URL=http://localhost:3000

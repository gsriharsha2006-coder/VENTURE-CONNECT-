# Browser-safe Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backward-compatible public key fallback only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Public application URL used for authentication redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PACE one-month pilot feature freeze.
PILOT_INVESTORS_ENABLED=false
PILOT_ADS_ENABLED=false
PILOT_EVENTS_ENABLED=false
PILOT_MULTIPLE_TEMPLATES_ENABLED=false
PILOT_READINESS_REPORT_LIMIT=1
PILOT_QUALITY_CHECK_LIMIT=2

# Development fixtures are always off unless explicitly enabled locally.
ENABLE_DEMO_DATA=false

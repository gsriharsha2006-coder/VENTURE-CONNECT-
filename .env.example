# Supabase foundation. Leave blank to run the mock/demo MVP.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred public browser key from Supabase project settings.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Temporary backward-compatible fallback. Leave blank when using the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/admin-only Supabase key. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay is a future integration. Do not use these in Phase 2.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Browser-safe checkout key ID only. Never expose the Razorpay secret.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_PLAN_STUDENT_PRO=
RAZORPAY_PLAN_FOUNDER_PRO=

# Server-only OpenAI configuration for VC Readiness Reports.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Legacy Gemini rollback variables. Gemini is not the active report provider.
# Remove these only after real OpenAI generation has been verified.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Reserved for future providers. It is not an active report provider.
SARVAM_API_KEY=

# Local app URL used for auth redirects when Supabase is configured.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Synthetic local fixtures are disabled by default. Never enable in production.
ENABLE_DEMO_DATA=false
